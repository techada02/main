# Environment Variables for KaamMitra Labour Marketplace Platform
# Copy this file to .env and fill in your actual values

# Server
PORT=3000

# JWT Secret (change this to a strong random string in production)
JWT_SECRET=kaammitra_change_this_secret_in_production

# Twilio SMS Configuration (Optional - SMS will be logged to console if not set)
# Get these from https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Admin Configuration
ADMIN_PHONE=+919876543210
ADMIN_KEY=kaammitra_admin_change_this
